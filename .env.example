# Crie uma aplicação e um bot no Discord Developer Portal.
# Nunca compartilhe o conteúdo do arquivo .env.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# ID da conta que poderá usar os comandos /dono
BOT_OWNER_ID=

# Caminhos locais; pastas necessárias são criadas automaticamente.
BOT_DB_PATH=./data/bot.sqlite
BOT_DATA_DIR=./data

# Configurações opcionais para /convite e /suporte.
INVITE_URL=
SUPPORT_URL=
